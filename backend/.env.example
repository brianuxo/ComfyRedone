# Configuración del backend
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ComfyUI (worker local - en Kaggle/Colab)
COMFY_HOST=127.0.0.1
COMFY_PORT=8188

# CORS (origen del frontend SPA)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCI / Object Storage (credenciales del script Kaggle -> OCI)
# RELLENA ESTOS VALORES CON TUS CREDENCIALES REALES
OCI_NAMESPACE=your_namespace
OCI_BUCKET=your_bucket
OCI_REGION=your_region
OCI_ACCESS_KEY_ID=your_access_key
OCI_SECRET_ACCESS_KEY=your_secret_key
OCI_ENDPOINT=https://your_namespace.compat.objectstorage.your_region.oci.customer-oci.com

# TTL de tareas en memoria (segundos)
TASK_TTL_SECONDS=3600